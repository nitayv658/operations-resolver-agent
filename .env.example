# Copy this file to .env and fill in your key. .env is gitignored -- never
# commit real credentials.

ANTHROPIC_API_KEY=

# Optional -- defaults to claude-sonnet-5 if unset.
ANTHROPIC_MODEL=claude-sonnet-5

# Optional -- overrides the fixed "today" the tools measure date arithmetic
# against (default 2026-08-05, from starter-kit/data/policies.json).
# QUEST4_REFERENCE_DATE=2026-08-05

# Optional -- the Anthropic SDK already retries connection errors and
# 408/409/429/5xx responses itself (default 2, exponential backoff). Only
# set this to override that default.
# ANTHROPIC_MAX_RETRIES=2

# Optional -- controls the structured JSON logs written to stderr by
# run_ticket.py / run_scenarios.py (DEBUG/INFO/WARNING/ERROR). Default
# WARNING -- a clean, successful run prints nothing to stderr.
# LOG_LEVEL=WARNING
